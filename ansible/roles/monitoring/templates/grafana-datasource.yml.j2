# Managed by Ansible (roles/monitoring) — do not edit by hand.
apiVersion: 1

datasources:
  - name: Prometheus
    uid: {{ grafana_datasource_uid }}
    type: prometheus
    access: proxy
    url: http://localhost:9090
    isDefault: true
    editable: false
    jsonData:
      timeInterval: {{ prometheus_scrape_interval }}
