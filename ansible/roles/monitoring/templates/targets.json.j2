{# file_sd target list for one scrape job, rendered per job from monitoring_targets.
   Optional fields arrive as null from Terraform, hence the .get(...) or ... defaults. #}
{%- set entries = [] -%}
{%- if monitoring_scrape_self | bool and job_name == monitoring_default_job -%}
{%-   set _ = entries.append({'targets': ['localhost:9100'], 'labels': {'name': monitoring_self_name}}) -%}
{%- endif -%}
{%- for t in monitoring_targets -%}
{%-   if (t.get('job') or monitoring_default_job) == job_name -%}
{%-     set _ = entries.append({'targets': [t['address']], 'labels': {'name': t['name']} | combine(t.get('labels') or {})}) -%}
{%-   endif -%}
{%- endfor -%}
{{ entries | to_nice_json }}
